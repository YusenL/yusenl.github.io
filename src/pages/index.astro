---
import BaseLayout from "../layouts/BaseLayout.astro";
import { researchAreas, site, updates } from "../data/site";
---

<BaseLayout
  title="Yusen Liu · Research"
  description="The personal research website of Yusen Liu, a researcher based in Sydney."
>
  <a class="skip-link" href="#content">Skip to content</a>

  <header class="site-header">
    <div class="header-inner">
      <a class="wordmark" href="/" aria-label="YL — Yusen Liu, home">
        <span class="wordmark-mark" aria-hidden="true">YL</span>
        <span>Yusen Liu</span>
      </a>

      <nav class="site-nav" aria-label="Primary navigation">
        <a href="#about">About</a>
        <a href="#research">Research</a>
        <a href="#publications">Publications</a>
        <a href="#contact">Contact</a>
      </nav>

      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle theme">
        <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="3.75"></circle>
          <path d="M12 2v2.25M12 19.75V22M4.93 4.93l1.59 1.59M17.48 17.48l1.59 1.59M2 12h2.25M19.75 12H22M4.93 19.07l1.59-1.59M17.48 6.52l1.59-1.59"></path>
        </svg>
        <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.3 15.2A8.5 8.5 0 0 1 8.8 3.7a8.5 8.5 0 1 0 11.5 11.5Z"></path>
        </svg>
      </button>
    </div>
  </header>

  <main id="content">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero-copy reveal reveal-1">
        <div class="availability">
          <span class="availability-dot" aria-hidden="true"></span>
          {site.location}
        </div>
        <p class="hero-kicker">Research · Ideas · Impact</p>
        <h1 id="hero-title">
          Asking useful questions.<br />
          <em>Building rigorous answers.</em>
        </h1>
        <p class="hero-intro">{site.intro}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#research">
            Explore research
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="m7 4 6 6-6 6"></path>
            </svg>
          </a>
          <a class="text-link" href={site.github} target="_blank" rel="noreferrer">
            GitHub
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M6 14 14 6M8 6h6v6"></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="research-visual reveal reveal-2" aria-hidden="true">
        <div class="visual-label">Research map</div>
        <svg viewBox="0 0 560 560" role="presentation">
          <defs>
            <linearGradient id="orbit-gradient" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="currentColor" stop-opacity="0.08"></stop>
              <stop offset="0.52" stop-color="currentColor" stop-opacity="0.55"></stop>
              <stop offset="1" stop-color="currentColor" stop-opacity="0.08"></stop>
            </linearGradient>
          </defs>
          <circle class="orbit orbit-one" cx="280" cy="280" r="210"></circle>
          <circle class="orbit orbit-two" cx="280" cy="280" r="142"></circle>
          <circle class="orbit orbit-three" cx="280" cy="280" r="76"></circle>
          <path class="signal-path" d="M70 280c62-113 132-170 210-170s148 57 210 170c-62 113-132 170-210 170S132 393 70 280Z"></path>
          <path class="signal-path signal-path-reverse" d="M280 70c113 62 170 132 170 210s-57 148-170 210C167 428 110 358 110 280S167 132 280 70Z"></path>
          <circle class="node node-a" cx="280" cy="70" r="8"></circle>
          <circle class="node node-b" cx="490" cy="280" r="8"></circle>
          <circle class="node node-c" cx="146" cy="390" r="8"></circle>
          <circle class="core-halo" cx="280" cy="280" r="42"></circle>
          <circle class="core" cx="280" cy="280" r="12"></circle>
        </svg>
        <span class="visual-word word-learning">Learning</span>
        <span class="visual-word word-methods">Methods</span>
        <span class="visual-word word-impact">Impact</span>
        <div class="visual-caption">
          <span>01</span>
          From foundational methods<br />to real-world systems
        </div>
      </div>
    </section>

    <section class="intro-band" id="about" aria-labelledby="about-title">
      <div class="section-shell intro-grid">
        <p class="section-label">About</p>
        <div class="intro-content">
          <h2 id="about-title">A home for ongoing work and open questions.</h2>
          <p>{site.about}</p>
        </div>
        <div class="intro-meta">
          <div>
            <span>Based in</span>
            <strong>{site.location}</strong>
          </div>
          <div>
            <span>Focus</span>
            <strong>Responsible, useful AI</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="section-shell section-block" id="research" aria-labelledby="research-title">
      <div class="section-heading">
        <p class="section-label">Research</p>
        <h2 id="research-title">Themes that connect<br />theory with practice.</h2>
        <p class="section-summary">
          An initial map of the topics this website will explore. These descriptions will evolve with the research profile.
        </p>
      </div>

      <div class="research-grid">
        {researchAreas.map((area) => (
          <article class="research-card">
            <div class="card-topline">
              <span>{area.index}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </div>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
            <ul aria-label={`${area.title} topics`}>
              {area.keywords.map((keyword) => <li>{keyword}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="publication-section" id="publications" aria-labelledby="publication-title">
      <div class="section-shell publication-grid">
        <div class="section-heading publication-heading">
          <p class="section-label section-label-light">Publications</p>
          <h2 id="publication-title">Selected work,<br />clearly presented.</h2>
        </div>
        <div class="publication-placeholder">
          <span class="placeholder-index">P/01</span>
          <div>
            <p class="placeholder-kicker">Profile in preparation</p>
            <h3>The publication list is being curated.</h3>
            <p>
              Papers will include concise summaries and direct links to manuscripts, code, data, and citation files.
            </p>
          </div>
          <div class="placeholder-tags" aria-label="Planned publication resources">
            <span>Paper</span>
            <span>Code</span>
            <span>BibTeX</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section-shell section-block updates-section" aria-labelledby="updates-title">
      <div class="section-heading compact-heading">
        <p class="section-label">Updates</p>
        <h2 id="updates-title">Now & next.</h2>
      </div>
      <div class="updates-list">
        {updates.map((update) => (
          <article class="update-item">
            <time>{update.date}</time>
            <p>{update.text}</p>
            <span class="update-marker" aria-hidden="true"></span>
          </article>
        ))}
        <article class="update-item update-item-muted">
          <time>Next</time>
          <p>Research projects and selected publications.</p>
          <span class="update-marker" aria-hidden="true"></span>
        </article>
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="section-shell contact-grid">
        <p class="section-label">Connect</p>
        <div>
          <h2 id="contact-title">Interested in the work?</h2>
          <p>Research links and contact details will be added as the profile is completed.</p>
        </div>
        <a class="circle-link" href={site.github} target="_blank" rel="noreferrer" aria-label="Visit Yusen Liu on GitHub">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M10 22 22 10M12 10h10v10"></path>
          </svg>
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="section-shell footer-inner">
      <div>
        <strong>{site.name}</strong>
        <span>{site.role} · {site.location}</span>
      </div>
      <p>Built with care and curiosity.</p>
      <a href="#content">Back to top ↑</a>
    </div>
  </footer>
</BaseLayout>
