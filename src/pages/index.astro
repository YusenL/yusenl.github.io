---
import BaseLayout from "../layouts/BaseLayout.astro";
import { focusAreas, site } from "../data/site";
---

<BaseLayout
  title="Yusen Liu · Research"
  description="The personal research website of Yusen Liu, a researcher based in Sydney."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="site-frame">
    <header class="site-header">
      <a class="identity" href="/" aria-label="YL — Yusen Liu, home">
        <span class="identity-mark" aria-hidden="true">YL</span>
        <span class="identity-name">Yusen Liu</span>
      </a>

      <p class="header-note">Research profile <span>·</span> Sydney</p>

      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle theme">
        <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="3.75"></circle>
          <path d="M12 2v2.25M12 19.75V22M4.93 4.93l1.59 1.59M17.48 17.48l1.59 1.59M2 12h2.25M19.75 12H22M4.93 19.07l1.59-1.59M17.48 6.52l1.59-1.59"></path>
        </svg>
        <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.3 15.2A8.5 8.5 0 0 1 8.8 3.7a8.5 8.5 0 1 0 11.5 11.5Z"></path>
        </svg>
      </button>
    </header>

    <main id="main" class="main-grid">
      <section class="intro" aria-labelledby="page-title">
        <p class="eyebrow"><span aria-hidden="true"></span> Yusen Liu / Researcher</p>
        <h1 id="page-title">
          Learning.<br />
          Optimization.<br />
          <em>What works.</em>
        </h1>
        <p class="intro-copy">{site.intro}</p>
        <a class="primary-link" href={site.github} target="_blank" rel="noreferrer">
          View GitHub
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M6 14 14 6M8 6h6v6"></path>
          </svg>
        </a>
      </section>

      <aside class="research-index" aria-label="Research focus diagram">
        <div class="index-head">
          <span>Research index</span>
          <span>001 / 2026</span>
        </div>

        <div class="coordinate-map" aria-hidden="true">
          <svg viewBox="0 0 520 520" role="presentation">
            <circle class="map-ring ring-outer" cx="260" cy="260" r="190"></circle>
            <circle class="map-ring ring-inner" cx="260" cy="260" r="105"></circle>
            <path class="map-axis" d="M40 260h440M260 40v440"></path>
            <path class="map-curve" d="M88 350c85-18 109-163 190-178 73-13 111 47 154 7"></path>
            <circle class="map-node node-one" cx="118" cy="337" r="7"></circle>
            <circle class="map-node node-two" cx="278" cy="172" r="7"></circle>
            <circle class="map-node node-three" cx="432" cy="179" r="7"></circle>
          </svg>
          <span class="map-label label-learn">Learn</span>
          <span class="map-label label-optimize">Optimize</span>
          <span class="map-label label-apply">Apply</span>
          <div class="map-center">YL</div>
        </div>

        <p class="index-caption">Methods → systems → impact</p>
      </aside>
    </main>

    <section class="info-rail" aria-label="Profile summary">
      <div class="rail-item rail-focus">
        <span class="rail-label">Focus</span>
        <ul>
          {focusAreas.map((area) => <li>{area}</li>)}
        </ul>
      </div>

      <div class="rail-item">
        <span class="rail-label">Selected work</span>
        <p>Publication list in preparation.</p>
      </div>

      <div class="rail-item rail-location">
        <span class="rail-label">Based in</span>
        <p>{site.location}</p>
      </div>
    </section>

    <footer class="site-footer">
      <span>© 2026 {site.name}</span>
      <span>Profile in progress</span>
    </footer>
  </div>
</BaseLayout>
